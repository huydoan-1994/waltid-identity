VERSION_TAG=stable

IMAGE_PREFIX=""
SERVICE_HOST=host.docker.internal

WALLET_BACKEND_PORT=7001
ISSUER_API_PORT=7002
ISSUER_API2_PORT=7005
VERIFIER_API_PORT=7003
VERIFIER_API2_PORT=7004
WALLET_API2_PORT=7006

DB_NAME=waltid
DB_USERNAME=waltid
DB_PASSWORD=waltid
POSTGRES_DB_PORT=5432
POSTGRES_DB_HOST=postgres
DATABASE_ENGINE=postgres
COMPOSE_PROFILES=identity

# -----------------------------------------------------------------------------
# AWS KMS — local dev: IAM user access key (issuer-api container → kms:Sign)
# Copy to .env and fill in. Never commit .env with real secrets.
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Do NOT set AWS_SESSION_TOKEN for long-lived IAM user keys (KmsException in Walt issuer).
# AWS_SESSION_TOKEN=   # only for temporary STS credentials
AWS_REGION=ap-southeast-1

# Reference for POST /openid4vc/sdjwt/issue body issuerKey.id (not read by Walt automatically)
ISSUER_KMS_KEY_ID=alias/ekyc-issuer-signing
